# Codegen demo — deliberately restricted to what Phase 6 (LLVM) supports:
# int-only fn/let/if-else/return/arithmetic + recursive calls.
# No print/loop/string/tensor/actor here (those stay interpreter-only).

fn add(a: int, b: int) -> int:
    return a + b

fn fib(n: int) -> int:
    if n < 2:
        return n
    else:
        return fib(n - 1) + fib(n - 2)

fn main() -> int:
    let x = add(3, 4)
    let y = fib(10)
    return x + y
