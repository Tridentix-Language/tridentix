fn classify(n: int) -> int:
    if n < 0:
        return 0
    elif n == 0:
        return 1
    else:
        return 2

fn main() -> int:
    let mut total = 0
    loop i in range(0, 5):
        print(i)
        total = total + i

    let mut count = 0
    while count < 3:
        print(count)
        count = count + 1

    print(classify(0 - 5))
    print(classify(0))
    print(classify(9))

    return total
